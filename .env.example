# ─── Required ────────────────────────────────────────────────────────────────
# Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → your application → General Information → Application ID
CLIENT_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# Your server's ID while testing: slash commands update instantly.
# Leave empty for production: global commands can take up to an hour to appear.
GUILD_ID=

# Where the SQLite database lives. Point this at a persistent volume when hosting.
DB_PATH=./data/bot.db
