{
  "name": "900lvlbot",
  "version": "2.0.0",
  "description": "A self-hosted Discord levelling bot with text and voice XP, 17 card themes, custom themes and an in-Discord control panel",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test",
    "previews": "node scripts/render-previews.js"
  },
  "dependencies": {
